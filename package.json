{
  "name": "appsheet-accounting-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Appsheet Accounting Journal — prototipe + mock API. Dev terpadu menjalankan mock API (port 4000) dan Vite (port 5173) bersamaan.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:extra": "node scripts/dev.mjs --extra",
    "dev:reset": "node scripts/dev.mjs --reset",
    "dev:no-persist": "node scripts/dev.mjs --no-persist",
    "dev:stop": "node scripts/dev-stop.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "release": "node scripts/create-release.mjs",
    "test": "node scripts/test-all.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:unit": "vitest run",
    "test:mock-api": "npm --prefix mock-api test",
    "test:prototype": "npm run test:unit",
    "test:e2e": "npm --prefix e2e test"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^15.11.0",
    "msw": "^2.15.0",
    "oxlint": "^1.75.0",
    "typescript": "~5.8.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.0"
  }
}
