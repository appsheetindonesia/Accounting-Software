{
  "name": "appsheet-accounting-journal",
  "version": "1.0.0",
  "private": true,
  "description": "Appsheet Accounting Journal — monorepo dokumen + mock API + prototipe. Skrip dev gabungan menjalankan mock API (port 4000) dan prototipe Vite (port 5173) bersamaan.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:extra": "node scripts/dev.mjs --extra",
    "dev:reset": "node scripts/dev.mjs --reset",
    "dev:no-persist": "node scripts/dev.mjs --no-persist",
    "dev:stop": "node scripts/dev-stop.mjs",
    "release": "node scripts/create-release.mjs",
    "test": "node scripts/test-all.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:mock-api": "npm --prefix mock-api test",
    "test:prototype": "npm --prefix prototype-accounting test",
    "test:e2e": "npm --prefix e2e test"
  }
}
